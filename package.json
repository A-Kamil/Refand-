{
  "name": "freightrecover-engine",
  "version": "1.0.0",
  "description": "FreightRecover AI \u2014 extraction, audit engine and recovery claims",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:pdf": "tsx scripts/generate-pdf-fixtures.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/run-demo.ts",
    "test:live": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "build:api": "tsc -p tsconfig.api.json",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "start": "node build/api/server.js",
    "dev": "tsx watch --env-file-if-exists=.env api/server.ts",
    "db:check": "tsx --env-file-if-exists=.env api/cli.ts check",
    "db:migrate": "tsx --env-file-if-exists=.env api/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env api/cli.ts seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Kamil/Refand-.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/A-Kamil/Refand-/issues"
  },
  "homepage": "https://github.com/A-Kamil/Refand-#readme",
