# Anthropic credentials (server-side only — never expose to the frontend)
ANTHROPIC_API_KEY=
# Optional overrides
FREIGHTRECOVER_AI_MODEL=claude-opus-5-5
FREIGHTRECOVER_AI_EFFORT=medium

# --- API server ---
# Aiven for PostgreSQL service URI (Console > service > Overview > Service URI). Injected automatically on Aiven Runtime.
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require
# Optional: Aiven project CA (PEM, "\n" escapes allowed) to fully verify the server certificate.
DATABASE_CA_CERT=
PORT=8080
# Extra allowed browser origins, comma-separated, `*` wildcards allowed (Lovable + localhost are allowed by default).
CORS_ORIGINS=
# Set to false to drop the default origins (localhost, *.lovable.app, *.lovableproject.com, *.lovable.dev).
CORS_DEFAULTS=true
MIGRATE_ON_START=true
SEED_ON_START=true
LOG_LEVEL=info
